# Required
MIKROTIK_BASE=https://192.168.88.1
MIKROTIK_USERNAME=mcp-agent
# Either MIKROTIK_PASSWORD or MIKROTIK_PASSWORD_FILE (recommended)
MIKROTIK_PASSWORD=
MIKROTIK_PASSWORD_FILE=/path/to/password-file
MIKROTIK_TIMEOUT=10
MIKROTIK_VERIFY_SSL=yes   # set "no" only for self-signed lab certs

# Mode: readonly (no mutation tools at all) | careful (default, confirms destructive) | yolo (unrestricted)
MIKROTIK_MODE=careful
# MIKROTIK_YOLO_USERNAME=mcp-admin
# MIKROTIK_YOLO_PASSWORD_FILE=/path/to/yolo-password
# MIKROTIK_STRICT_CONFIRM=1   # confirm EVERY mutation in careful mode

# Optional capabilities (default off — enable only if you need them)
# MIKROTIK_ENABLE_CONTAINER_SHELL=1
# MIKROTIK_ENABLE_LOCAL_FILES=1
# MIKROTIK_LOCAL_ROOT=/tmp/mikrotik-files
# MIKROTIK_REDACT=1           # scrub secrets from tool output (default on)
